# Server Port
PORT=5000

# Security: Strong JWT secret key for signing auth tokens (change in production!)
JWT_SECRET=placement-secret-key-2026-institutional-grade

# Database Engine: 'mysql' for MySQL server, 'sqlite' for zero-dependency local file DB
DB_TYPE=mysql

# MySQL Server Configuration (Required if DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=placement_verification

# SQLite Database Fallback & Migration Source (Required if DB_TYPE=sqlite)
DATABASE_PATH=./data/placement.db

# Institutional Admin Primary Account (automatically created on db:setup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@placement.edu
ADMIN_PASSWORD=Admin@123

# Set to true only if you want sample demo test data preloaded on initialization
SEED_DUMMY_DATA=false
